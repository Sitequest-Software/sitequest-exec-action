{
  "name": "sitequest-exec-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action: run a shell command on a Sitequest VPS or webspace via the REST API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit",
    "all": "bun run lint && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitequest/exec-action.git"
  },
  "keywords": ["github-action", "sitequest", "ssh", "exec", "vps", "webspace"],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0"
  }
}
